<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Assets/_Game/Scripts/Core with Unity's language level (C# 9, .NET Standard 2.1). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NightCourier.Core</AssemblyName>
    <RootNamespace>NightCourier.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Game/Scripts/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Template.Core.csproj" />
  </ItemGroup>
</Project>
